<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EstateAgency.App"
             RequestedThemeVariant="Light">

    <!-- РЕСУРСЫ: цвета с именами (x:Key). Формы берут их через {StaticResource Имя}. -->
    <Application.Resources>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#DCE8F5" />      <!-- фон шапки и панелей -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2F6DB5" />       <!-- главные кнопки -->
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#25588F" />  <!-- кнопка под курсором -->
        <SolidColorBrush x:Key="LowStockBrush" Color="#FF8080" />     <!-- мало показов, подтверждения -->
        <SolidColorBrush x:Key="NormalBrush" Color="#FFFFFF" />       <!-- обычный фон -->
        <SolidColorBrush x:Key="MutedBrush" Color="#4F5A69" />        <!-- второстепенный текст -->
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Calibri" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Background" Value="{StaticResource NormalBrush}" />
        </Style>
        <!-- Для всех кнопок: внутренний и внешний отступ. -->
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <!-- Только для кнопок с Classes="accent": акцентный цвет и белый текст. -->
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Класс accent есть и в теме Fluent, поэтому цвет задаём и для шаблона кнопки. -->
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Длинный текст переносится на новую строку, а не обрезается. -->
        <Style Selector="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Только для TextBlock с Classes="heading": крупный жирный заголовок. -->
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <!-- Панель с группой действий на странице заявки. -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </Application.Styles>
</Application>
