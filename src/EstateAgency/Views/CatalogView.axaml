<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EstateAgency.Views.CatalogView"
             Tag="Каталог объектов">
    <DockPanel>
        <!-- Верхняя часть: заголовок, поиск, тип объекта, сортировка, счётчик. -->
        <StackPanel DockPanel.Dock="Top" Spacing="8">
            <TextBlock Classes="heading" Text="Каталог объектов недвижимости" />
            <TextBox x:Name="SearchBox" PlaceholderText="Поиск по названию, коду или адресу"
                     TextChanged="SearchChanged" />
            <Grid ColumnDefinitions="*,250,Auto,Auto" Margin="0,0,0,4">
                <ComboBox x:Name="TypeBox" HorizontalAlignment="Stretch" Margin="0,0,6,0"
                          SelectionChanged="FilterChanged" />
                <ComboBox x:Name="SortBox" Grid.Column="1" HorizontalAlignment="Stretch"
                          SelectionChanged="FilterChanged">
                    <ComboBoxItem Content="Цена по возрастанию" />  <!-- индекс 0 -->
                    <ComboBoxItem Content="Цена по убыванию" />     <!-- индекс 1 -->
                </ComboBox>
                <CheckBox x:Name="OpenOnlyBox" Grid.Column="2" Content="Только доступные" Margin="10,0,6,0"
                          Click="OpenOnlyClick" />
                <Button Grid.Column="3" Content="Обновить" Click="ReloadClick" />
            </Grid>
            <TextBlock x:Name="CountText" />
        </StackPanel>

        <!-- Список карточек. ItemsSource заполняется из C# объектами PropertyCard. -->
        <ListBox x:Name="CardsList" SelectionChanged="CardSelected" Margin="0,6,0,0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Background}" Padding="10" CornerRadius="4"
                            BorderBrush="#C9D3DF" BorderThickness="1">
                        <Grid ColumnDefinitions="170,*,230">
                            <Image Source="{Binding Image}" Width="160" Height="100" Stretch="Uniform" />
                            <StackPanel Grid.Column="1" Spacing="2" Margin="12,0">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Address}" />
                                <TextBlock Text="{Binding Params}" />
                                <TextBlock>
                                    <Run Text="{Binding Type}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Status}" />
                                    <Run Text=" · " />
                                    <Run Text="{Binding Code}" />
                                </TextBlock>
                                <TextBlock Text="{Binding ViewingsText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{Binding PriceText}" FontWeight="Bold" />
                                <TextBlock Text="{Binding CommissionText}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>
