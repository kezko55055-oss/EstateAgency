<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EstateAgency.Views.RegistrationView"
             Tag="Регистрация клиента">
    <ScrollViewer>
        <StackPanel Spacing="6" MaxWidth="460" HorizontalAlignment="Left">
            <TextBlock Classes="heading" Text="Регистрация клиента" />
            <TextBlock Text="Фамилия:" />
            <TextBox x:Name="LastNameBox" />
            <TextBlock Text="Имя:" />
            <TextBox x:Name="FirstNameBox" />
            <TextBlock Text="Отчество (необязательно):" />
            <TextBox x:Name="MiddleNameBox" />
            <TextBlock Text="Телефон:" />
            <TextBox x:Name="PhoneBox" PlaceholderText="+79110000000" />
            <TextBlock Text="Электронная почта:" />
            <TextBox x:Name="EmailBox" />
            <TextBlock Text="Логин (не меньше 3 символов):" />
            <TextBox x:Name="LoginBox" />
            <TextBlock Text="Пароль (не меньше 3 символов):" />
            <TextBox x:Name="PasswordBox" PasswordChar="●" />
            <Button x:Name="RegisterButton" Content="Зарегистрироваться" Classes="accent" Click="RegisterClick" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
